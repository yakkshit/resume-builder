# Optional: YouTube watch URL, youtu.be link, or full embed URL — shown at the end of the /chat onboarding guide
NEXT_PUBLIC_CHAT_ONBOARDING_VIDEO_URL=

# Multi-model API (for interview AI + docs links)
NEXT_PUBLIC_MULTI_MODEL_API_URL=https://generativelanguage.googleapis.com
NEXT_PUBLIC_MULTI_MODEL_DOCS_URL=https://ai.google.dev/gemini-api/docs
MULTI_MODEL_API_URL=https://generativelanguage.googleapis.com

# Google Gemini (required for Interview Lab)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenAI (optional, for Whisper transcription fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Vercel Sandbox (optional, for isolated code execution)
VERCEL_PROJECT_ID=prj_xxxxx
VERCEL_TEAM_ID=team_xxxxx
# Run: vercel link && vercel env pull to get OIDC token
# VERCEL_OIDC_TOKEN=

# Optional: POST /api/translate — for scripts/tooling only. Chat resume “View in” uses in-browser WASM (Bergamot).
GOOGLE_TRANSLATE_API_KEY=
# LIBRETRANSLATE_URL=https://your-libretranslate.example.com
# LIBRETRANSLATE_API_KEY=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# PostgreSQL / Xata Database
DATABASE_URL=postgresql://user:password@localhost:5432/career_agent
